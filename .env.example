# Salin ke .env lalu isi nilainya, tanpa spasi atau tanda kutip di sekitar nilai.
# .env tidak pernah di-commit. Di GitHub, nilai yang sama disimpan sebagai Secrets
# (pipeline.yml hanya membaca Secrets); di Vercel, sebagai Environment Variables.
# REVALIDATE_SECRET, HEALTH_TOKEN, dan SITE_URL ditambahkan di fase 2.

# Pipeline: string koneksi Supabase "Session pooler" (tombol Connect di dashboard).
# Wajib session pooler, karena runner GitHub hanya mendukung IPv4.
SUPABASE_DB_URL=

# Pipeline: key gratis. BPS dari webapi.bps.go.id, FRED dari fred.stlouisfed.org.
BPS_API_KEY=
FRED_API_KEY=

# Vercel (hanya server) dan pipeline (uji akses setelah migrasi).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
