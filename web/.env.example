# Variabel environment situs (hanya server; jangan pernah pakai awalan NEXT_PUBLIC_).
# Di Vercel isi lewat Environment Variables. Untuk lokal, `npm run salin-env` menyalin dua baris
# Supabase dari ../.env ke .env.local (diabaikan git) tanpa menampilkan nilainya.

# Alamat proyek Supabase, misalnya https://<ref>.supabase.co
SUPABASE_URL=
# Publishable key Supabase (sb_publishable_...). Hanya bisa SELECT tabel public.
SUPABASE_PUBLISHABLE_KEY=
# Rahasia bersama dengan pipeline untuk POST /api/revalidate (header x-revalidate-secret).
REVALIDATE_SECRET=
# Token untuk GET /api/health dari cron-job.org (header x-health-token).
HEALTH_TOKEN=
